{
  "name": "karmi-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "db:generate": "pnpm --filter @karmi/core db:generate",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,mts,js}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,js}\"",
    "prose:check": "node scripts/vale-terms.mjs --check && vale --minAlertLevel=error README.md AGENTS.md CONTEXT.md docs/agents packages/*/README.md packages/create-karmi/template .changeset",
    "prose:terms": "node scripts/vale-terms.mjs",
    "test": "turbo run test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "eslint-plugin-jsdoc": "^64.3.10",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.4",
    "turbo": "^2.10.12",
    "typescript": "~5.9.3"
  }
}
