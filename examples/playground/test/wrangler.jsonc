// The test Worker: the same baseline with the test entry, which uses a scripted Provider.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karmi-playground-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["global_fetch_strictly_public"],
  // The browser files. The Worker answers `/api` and `/threads`, where it checks the access token.
  "assets": { "directory": "../public", "run_worker_first": ["/api/*", "/threads", "/threads/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "KARMI_THREADS", "class_name": "ThreadDO" },
      { "name": "KARMI_SCOPES", "class_name": "ScopeConfigDO" },
      { "name": "KARMI_MEMORY", "class_name": "MemoryDO" },
      { "name": "KARMI_KNOWLEDGE", "class_name": "KnowledgeDO" },
      { "name": "PLAYGROUND_DATA", "class_name": "SampleDataDO" }
    ]
  },
  "migrations": [
    { "tag": "karmi-v1", "new_sqlite_classes": ["ThreadDO", "ScopeConfigDO"] },
    { "tag": "karmi-v2", "new_sqlite_classes": ["MemoryDO"] },
    { "tag": "karmi-v3", "new_sqlite_classes": ["KnowledgeDO"] },
    { "tag": "playground-v1", "new_sqlite_classes": ["SampleDataDO"] }
  ],
  "r2_buckets": [{ "binding": "KARMI_MEDIA", "bucket_name": "karmi-playground-test-media" }],
  "queues": {
    "producers": [{ "binding": "KARMI_QUEUE", "queue": "karmi-playground-test-queue" }],
    "consumers": [{ "queue": "karmi-playground-test-queue", "max_batch_timeout": 0, "max_retries": 3, "dead_letter_queue": "karmi-playground-test-dlq" }]
  }
}
