{
  "name": "create-karmi",
  "version": "0.0.0",
  "description": "Scaffolds a karmi project: the wrangler baseline, a sample Agent and Tool, external triggers, tests and CI.",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "template", "LICENSE"],
  "bin": {
    "create-karmi": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f -fe .js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^10.9.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
