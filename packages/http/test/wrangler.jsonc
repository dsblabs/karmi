// The test Worker config: the published karmi baseline pointed at the test entry.
{
  "name": "karmi-http-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [
      { "name": "KARMI_THREADS", "class_name": "ThreadDO" },
      { "name": "KARMI_SCOPES", "class_name": "ScopeConfigDO" }
    ]
  },
  "migrations": [{ "tag": "karmi-v1", "new_sqlite_classes": ["ThreadDO", "ScopeConfigDO"] }],
  "r2_buckets": [{ "binding": "KARMI_MEDIA", "bucket_name": "karmi-http-test-media" }],
  "queues": {
    "producers": [{ "binding": "KARMI_QUEUE", "queue": "karmi-http-test-queue" }],
    "consumers": [{ "queue": "karmi-http-test-queue", "max_batch_timeout": 0, "max_retries": 3, "dead_letter_queue": "karmi-http-test-dlq" }]
  }
}
