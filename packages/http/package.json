{
  "name": "@karmi/http",
  "version": "0.0.0",
  "description": "REST, Server-Sent Events and WebSocket routes over the karmi Thread API, behind an auth callback you write.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f -fe .js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@karmi/core": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@karmi/core": "workspace:*",
    "eslint": "^10.9.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0",
    "zod": "^4.5.4"
  }
}
