{
  "name": "@karmi/core",
  "version": "0.0.0",
  "description": "A code-first TypeScript framework for building agent harnesses that run natively on Cloudflare.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "wrangler.baseline.jsonc",
    "LICENSE",
    "src/vendor/codemode/NOTICE",
    "src/vendor/codemode/LICENSE",
    "bin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./wrangler.baseline.jsonc": "./wrangler.baseline.jsonc",
    "./sandbox": {
      "types": "./dist/sandbox-runtime.d.ts",
      "default": "./dist/sandbox-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f -fe .js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:vector-bench": "vitest run --config vitest.vector-bench.config.mts",
    "test:vectorize-live": "vitest run --config vitest.vectorize-live.config.mts"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260904.1",
    "eslint": "^10.9.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0",
    "zod": "^4.5.4"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.9",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "aws4fetch": "^1.0.20",
    "file-type": "^22.1.0",
    "jsonc-parser": "^3.3.1",
    "ulid": "^3.0.2"
  },
  "bin": {
    "karmi": "./bin/karmi.mjs"
  }
}
