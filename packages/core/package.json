{
  "name": "@karmi/core",
  "version": "0.0.0",
  "description": "A code-first TypeScript framework for building agent harnesses that run natively on Cloudflare.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "wrangler.baseline.jsonc"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wrangler.baseline.jsonc": "./wrangler.baseline.jsonc"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260904.1",
    "eslint": "^10.9.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0",
    "zod": "^4.5.4"
  }
}
