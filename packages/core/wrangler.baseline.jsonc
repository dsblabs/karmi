// The published karmi wrangler baseline (ADR-0002). Copy into a project and adjust `name` and `main`.
// `karmi doctor` checks a project's config against this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-karmi-worker",
  "main": "src/worker.ts",
  // The one hard requirement: karmi refuses to start below this date. `nodejs_compat` is implied by it.
  "compatibility_date": "2026-08-04",
  // Recommended: SSRF hardening for every outbound fetch.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // DO classes must be named re-exports of the Worker entry: `export const { ThreadDO, ScopeConfigDO, MemoryDO } = karmi.durableObjects`.
  "durable_objects": {
    "bindings": [
      { "name": "KARMI_THREADS", "class_name": "ThreadDO" },
      { "name": "KARMI_SCOPES", "class_name": "ScopeConfigDO" },
      { "name": "KARMI_MEMORY", "class_name": "MemoryDO" }
    ]
  },
  "migrations": [
    { "tag": "karmi-v1", "new_sqlite_classes": ["ThreadDO", "ScopeConfigDO"] },
    { "tag": "karmi-v2", "new_sqlite_classes": ["MemoryDO"] }
  ],
  "r2_buckets": [{ "binding": "KARMI_MEDIA", "bucket_name": "my-karmi-media" }],
  "queues": {
    "producers": [{ "binding": "KARMI_QUEUE", "queue": "my-karmi-queue" }],
    "consumers": [{ "queue": "my-karmi-queue", "max_retries": 3, "dead_letter_queue": "my-karmi-dlq" }]
  },
  // Optional, required only for isolate scripts: "worker_loaders": [{ "binding": "KARMI_LOADER" }],
  // Secrets are set with `wrangler secret put`, never here: KARMI_KEYRING (the credential store's key ring, see README).
  "observability": { "enabled": true }
}
